# NPM Configuration for Cross-Platform Compatibility
# This allows smooth installation on Windows locally and Linux on Render

# Allow using prebuilt binaries when available (Windows)
# On Render (Linux), it will use Linux prebuilts or build from source
ignore-scripts=false

# Use exact versions for consistency
save-exact=false

# Prefer offline mode if available (faster on Render)
prefer-offline=false

# Allow optional dependencies
legacy-peer-deps=true
